[Unit]
Description=Trading reporting after-open (dry run)
Wants=network-online.target
After=network-online.target
[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/opt/trading-agents
EnvironmentFile=/opt/trading-agents/.env
Environment=ALPACA_PAPER=True DRY_RUN=True TZ=America/New_York PYTHONIOENCODING=utf-8 PYTHONUNBUFFERED=1
ExecStart=/usr/bin/flock -w 20 /opt/trading-agents/app/state/reporting.lock /usr/bin/env ALPACA_PAPER=True DRY_RUN=True /opt/trading-agents/.venv/bin/python reporting_job.py after-open --telegram
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trading-after-open
NoNewPrivileges=true
PrivateTmp=true
